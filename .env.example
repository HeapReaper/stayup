# Example environment file
# Copy .env.example to .env and fill in the values

# Prisma
DB_PROVIDER="sqlite" # postgresql or sqlite
DB_URL="" # Example: SQlite: file:./dev.db OR PSQL: postgresql://user:password@localhost:5432/nexttemp?schema=public

# Redis (optional)
REDIS_URL="" # Example: redis://localhost:6379

# Better Auth
BETTER_AUTH_SECRET="your-generated-secret"
BETTER_AUTH_URL="http://localhost:3000"

# Port `next dev`/`next start` binds to (also used by docker-compose's `web`
# port mapping and healthcheck). Defaults to 3000 if unset.
PORT=3000

# Email (optional)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="NextTemp <noreply@yourdomain.com>"

# Logs
LOG_LEVEL="info" # info, error, debug, warning

# Docker Compose only (`docker compose up`) — sets the postgres container's
# password. DB_PROVIDER/DB_URL/REDIS_URL above are ignored by compose; it
# forces those to the in-network postgres/redis hostnames itself (see
# docker-compose.yml). Not used by `npm run dev`.
POSTGRES_PASSWORD="change-me"

# Update checks (optional) — only needed when running a fork. The dashboard
# and worker/cmd/janitor ask this project whether a newer StayUp exists; the
# defaults point at the upstream GitLab project, and the running build's own
# version comes from STAYUP_BUILD_VERSION, which the Dockerfile sets from CI.
STAYUP_UPDATE_PROJECT_API="" # e.g. https://gitlab.com/api/v4/projects/HeapReaper%2Fstayup
STAYUP_UPDATE_WEB_URL=""     # e.g. https://gitlab.com/HeapReaper/stayup
STAYUP_UPDATE_BRANCH=""      # branch the `latest` image is built from [main]

# Single sign-on (optional) — OIDC / OAuth via better-auth's genericOAuth
# plugin. Left blank, nothing is registered and the sign-in page shows only
# the password form. Configured here rather than on the Settings page on
# purpose: the client secret has no business round-tripping through a form,
# and better-auth resolves its provider list once at startup anyway.
#
# Set OIDC_CLIENT_ID plus either OIDC_DISCOVERY_URL (normal) or the explicit
# endpoint trio (for providers that publish no discovery document).
# The redirect URI to register with the IdP is:
#   $BETTER_AUTH_URL/api/auth/callback/$OIDC_PROVIDER_ID
OIDC_CLIENT_ID=""
OIDC_CLIENT_SECRET=""
OIDC_DISCOVERY_URL=""      # e.g. https://idp.example.com/.well-known/openid-configuration
OIDC_AUTHORIZATION_URL=""  # only needed without discovery
OIDC_TOKEN_URL=""          # only needed without discovery
OIDC_USERINFO_URL=""       # only needed without discovery
OIDC_PROVIDER_ID=""        # path segment in the callback URL [oidc]
OIDC_PROVIDER_NAME=""      # label on the sign-in button [Single sign-on]
OIDC_SCOPES=""             # [openid profile email]
# false = an IdP account with no StayUp user is rejected rather than created.
# Set this when the IdP covers more people than this instance should let in.
OIDC_ALLOW_SIGNUP=""       # [true]
# Role given to accounts the IdP creates. The very first account on an
# instance is always Admin regardless — it has nobody to grant it a role.
OIDC_DEFAULT_ROLE=""       # Admin | Member | Viewer [Viewer]
