# Example environment file
# Copy .env.example to .env and fill in the values

# Prisma
DB_PROVIDER="sqlite" # postgresql or sqlite
DB_URL="" # Example: SQlite: file:./dev.db OR PSQL: postgresql://user:password@localhost:5432/nexttemp?schema=public

# Redis (optional)
REDIS_URL="" # Example: redis://localhost:6379

# Better Auth
BETTER_AUTH_SECRET="your-generated-secret"
BETTER_AUTH_URL="http://localhost:3000"

# Port `next dev`/`next start` binds to (also used by docker-compose's `web`
# port mapping and healthcheck). Defaults to 3000 if unset.
PORT=3000

# Email (optional)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="NextTemp <noreply@yourdomain.com>"

# Logs
LOG_LEVEL="info" # info, error, debug, warning

# Docker Compose only (`docker compose up`) — sets the postgres container's
# password. DB_PROVIDER/DB_URL/REDIS_URL above are ignored by compose; it
# forces those to the in-network postgres/redis hostnames itself (see
# docker-compose.yml). Not used by `npm run dev`.
POSTGRES_PASSWORD="change-me"