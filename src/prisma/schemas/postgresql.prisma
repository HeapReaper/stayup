datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String           @id
  name            String
  email           String
  emailVerified   Boolean          @default(false)
  image           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  // better-auth's admin plugin (src/lib/auth.ts) — lets dashboard-authenticated
  // users create other users via auth.api.createUser without a public
  // self-service /register flow. Not used for permission gating anywhere in
  // this app (every logged-in user has full dashboard access, same as
  // before); the plugin just requires these columns to exist.
  role            String?
  banned          Boolean?         @default(false)
  banReason       String?
  banExpires      DateTime?
  sessions        Session[]
  accounts        Account[]
  monitors        Monitor[]
  incidents       Incident[]
  incidentUpdates IncidentUpdate[]
  statusPages     StatusPage[]
  integrations    Integration[]
  auditLogs       AuditLog[]

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  impersonatedBy String? // better-auth admin plugin column; unused (see User.role)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  type String?
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Monitor {
  id            String              @id @default(cuid())
  name          String
  url           String
  type          String              @default("HTTP") // HTTP | Ping | Port | DNS
  status        String              @default("Up") // Up | Down | Degraded
  interval      String              @default("60s") // 15s | 30s | 60s | 5m
  port          Int?
  uptime        Float               @default(100)
  responseTime  Int?
  lastCheckedAt DateTime?
  createdById   String?
  createdBy     User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  checks        MonitorCheck[]
  incidents     Incident[]
  statusPages   StatusPageMonitor[]

  @@index([createdById])
  @@map("monitor")
}

// A single check performed by a worker (e.g. src/workers/https.ts) against a
// monitor. Each row is one "ping" — the aggregate fields on Monitor (status,
// responseTime, uptime, lastCheckedAt) are derived from these.
model MonitorCheck {
  id           String   @id @default(cuid())
  monitorId    String
  monitor      Monitor  @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  status       String // Up | Down | Degraded
  statusCode   Int?
  responseTime Int? // ms
  message      String?
  checkedAt    DateTime @default(now())

  @@index([monitorId, checkedAt])
  @@map("monitor_check")
}

model Incident {
  id          String    @id @default(cuid())
  title       String
  impact      String    @default("Major") // Critical | Major | Minor
  status      String    @default("Investigating") // Investigating | Identified | Monitoring | Resolved
  monitorId   String?
  monitor     Monitor?  @relation(fields: [monitorId], references: [id], onDelete: SetNull)
  createdById String? // null when auto-created by a worker
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  updates               IncidentUpdate[]
  subscribers           IncidentSubscriber[]
  integrationDeliveries IntegrationDelivery[]

  @@index([monitorId])
  @@index([createdById])
  @@map("incident")
}

// A timeline entry on an incident (e.g. "We've identified the issue"). Every
// status change (including the initial report and the final resolution) is
// recorded as one of these, so the incident's history is just its update list.
model IncidentUpdate {
  id         String   @id @default(cuid())
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  status     String // Investigating | Identified | Monitoring | Resolved
  message    String
  authorId   String? // null when posted automatically by a worker
  author     User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([incidentId, createdAt])
  @@map("incident_update")
}

// Email subscribers for incident notifications. Self-serve "Subscribe to
// updates" is a future feature — rows here can currently only exist if seeded
// directly — but every incident update already emails whoever is in here.
model IncidentSubscriber {
  id         String   @id @default(cuid())
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  email      String
  createdAt  DateTime @default(now())

  @@unique([incidentId, email])
  @@map("incident_subscriber")
}

// A public status page: a curated view of some of your monitors, with an
// uptime history, incident feed, and its own subscribers — served at
// /status/[slug] (see src/app/(status)).
model StatusPage {
  id                String   @id @default(cuid())
  name              String
  slug              String   @unique
  description       String?
  logoUrl           String?
  theme             String   @default("system") // light | dark | system
  primaryColor      String   @default("#7c3aed")
  historyWindowDays Int      @default(90) // 7 | 30 | 90
  isPublished       Boolean  @default(true)
  createdById       String?
  createdBy         User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  groups      StatusPageGroup[]
  monitors    StatusPageMonitor[]
  subscribers StatusPageSubscriber[]

  @@index([createdById])
  @@map("status_page")
}

// A user-defined heading monitors can be grouped under on a status page (e.g.
// "Core services" / "Third-party dependencies"). Purely cosmetic grouping —
// scoped to one status page.
model StatusPageGroup {
  id           String     @id @default(cuid())
  statusPageId String
  statusPage   StatusPage @relation(fields: [statusPageId], references: [id], onDelete: Cascade)
  name         String
  order        Int        @default(0)

  monitors StatusPageMonitor[]

  @@index([statusPageId])
  @@map("status_page_group")
}

// Join row: which monitors appear on a status page, in which group (if any),
// and in what order.
model StatusPageMonitor {
  id           String           @id @default(cuid())
  statusPageId String
  statusPage   StatusPage       @relation(fields: [statusPageId], references: [id], onDelete: Cascade)
  monitorId    String
  monitor      Monitor          @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  groupId      String?
  group        StatusPageGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  order        Int              @default(0)

  @@unique([statusPageId, monitorId])
  @@index([statusPageId])
  @@index([groupId])
  @@map("status_page_monitor")
}

// Someone subscribed to updates for an entire status page (as opposed to
// IncidentSubscriber, which is scoped to one incident) — notified by email or
// a Discord webhook whenever an incident affecting one of this page's
// monitors gets a new update.
model StatusPageSubscriber {
  id           String     @id @default(cuid())
  statusPageId String
  statusPage   StatusPage @relation(fields: [statusPageId], references: [id], onDelete: Cascade)
  channel      String // Email | Discord
  target       String // email address, or a Discord webhook URL
  createdAt    DateTime   @default(now())

  @@unique([statusPageId, channel, target])
  @@index([statusPageId])
  @@map("status_page_subscriber")
}

// A record of a significant dashboard action, shown on the Logs page's Audit
// Logs tab. actorName is a denormalized snapshot so the log stays readable
// even after the acting user is deleted (actorId goes null via SetNull).
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorName String
  action    String // e.g. CREATED_MONITOR, RESOLVED_INCIDENT, DELETED_STATUS_PAGE
  target    String // human-readable label of what was acted on
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("audit_log")
}

// An outgoing notification channel (Discord/Slack/Webhook/Telegram/Email/
// PagerDuty). `target` holds the primary destination (webhook URL, email
// address, chat ID, or PagerDuty routing key); `secret` only applies to
// Telegram (bot token).
model Integration {
  id          String   @id @default(cuid())
  name        String
  type        String // Discord | Slack | Webhook | Telegram | Email | PagerDuty
  target      String
  secret      String?
  enabled     Boolean  @default(true)
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deliveries IntegrationDelivery[]

  @@index([createdById])
  @@map("integration")
}

// A queued/attempted notification through one Integration. Written by
// src/lib/incidents.ts whenever an incident update happens (or by a manual
// "Send test" action) and delivered by src/workers/integrations.ts.
model IntegrationDelivery {
  id            String      @id @default(cuid())
  integrationId String
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  incidentId    String?
  incident      Incident?   @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  event         String // e.g. "Incident Alert", "Test Notification"
  message       String
  status        String      @default("Pending") // Pending | Sent | Failed
  attempts      Int         @default(0)
  error         String?
  createdAt     DateTime    @default(now())
  sentAt        DateTime?

  @@index([integrationId, createdAt])
  @@index([status])
  @@map("integration_delivery")
}

// Single-row table (id is always "singleton") holding instance-wide config
// shown on the Settings page. Use src/lib/settings.ts's getSettings() rather
// than querying this directly — it creates the row (with generated API/
// webhook secrets) on first use.
model AppSettings {
  id                       String   @id @default("singleton")
  organizationName         String   @default("My Organization")
  timezone                 String   @default("utc")
  supportEmail             String?
  defaultCheckInterval     String   @default("60s") // 15s | 30s | 60s | 5m
  httpTimeoutSeconds       Int      @default(30)
  failedAttemptsThreshold  Int      @default(1)
  latencyThresholdMs       Int      @default(800)
  sslCheckEnabled          Boolean  @default(true)
  certExpiryWarningEnabled Boolean  @default(true)
  smtpHost                 String?
  smtpPort                 Int?
  smtpUser                 String?
  smtpPass                 String?
  smtpFromEmail            String?
  smtpFromName             String?
  smtpUseTls               Boolean  @default(true)
  apiKey                   String   @unique
  webhookSigningSecret     String
  updatedAt                DateTime @updatedAt

  @@map("app_settings")
}
