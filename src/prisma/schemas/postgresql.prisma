datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String           @id
  name            String
  email           String
  emailVerified   Boolean          @default(false)
  image           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  // better-auth's admin plugin (src/lib/auth.ts) — lets dashboard-authenticated
  // users create other users via auth.api.createUser without a public
  // self-service /register flow. Not used for permission gating anywhere in
  // this app (every logged-in user has full dashboard access, same as
  // before); the plugin just requires these columns to exist.
  role            String?
  banned          Boolean?         @default(false)
  banReason       String?
  banExpires      DateTime?
  sessions           Session[]
  accounts           Account[]
  monitors           Monitor[]
  incidents          Incident[]           @relation("IncidentCreatedBy")
  acknowledgedIncidents Incident[]        @relation("IncidentAcknowledgedBy")
  incidentUpdates    IncidentUpdate[]
  statusPages        StatusPage[]
  integrations       Integration[]
  auditLogs          AuditLog[]
  maintenanceWindows MaintenanceWindow[]
  escalationPolicies EscalationPolicy[]

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  impersonatedBy String? // better-auth admin plugin column; unused (see User.role)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  type String?
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Monitor {
  id            String              @id @default(cuid())
  name          String
  url           String
  type          String              @default("HTTP") // HTTP | Ping | Port | DNS
  status        String              @default("Up") // Up | Down | Degraded
  interval      String              @default("60s") // 15s | 30s | 60s | 5m
  port          Int?
  uptime        Float               @default(100)
  responseTime  Int?
  lastCheckedAt DateTime?
  createdById   String?
  createdBy     User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  // Optional paging chain — if set, an open incident on this monitor is paged
  // through EscalationPolicy.steps (in order, one step per X minutes of no
  // acknowledgement) instead of the usual broadcast to every enabled
  // Integration. See worker/internal/incidents's EscalateOverdueIncidents (the Go integrations worker).
  escalationPolicyId String?
  escalationPolicy   EscalationPolicy? @relation(fields: [escalationPolicyId], references: [id], onDelete: SetNull)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  checks              MonitorCheck[]
  incidents           Incident[]
  statusPages         StatusPageMonitor[]
  maintenanceWindows  MaintenanceWindowMonitor[]
  tags                MonitorTag[]

  @@index([createdById])
  @@index([escalationPolicyId])
  @@map("monitor")
}

// A single check performed by a worker (e.g. the Go binary built from worker/cmd/https) against a
// monitor. Each row is one "ping" — the aggregate fields on Monitor (status,
// responseTime, uptime, lastCheckedAt) are derived from these.
model MonitorCheck {
  id           String   @id @default(cuid())
  monitorId    String
  monitor      Monitor  @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  status       String // Up | Down | Degraded
  statusCode   Int?
  responseTime Int? // ms
  message      String?
  checkedAt    DateTime @default(now())

  @@index([monitorId, checkedAt])
  @@map("monitor_check")
}

model Incident {
  id          String    @id @default(cuid())
  title       String
  impact      String    @default("Major") // Critical | Major | Minor
  status      String    @default("Investigating") // Investigating | Identified | Monitoring | Resolved
  monitorId   String?
  monitor     Monitor?  @relation(fields: [monitorId], references: [id], onDelete: SetNull)
  createdById String? // null when auto-created by a worker
  createdBy   User?     @relation("IncidentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Root-cause writeup, added after the incident is resolved. Only shown on
  // the public status page once postmortemPublishedAt is set — saving a
  // draft (publishedAt still null) keeps it dashboard-only.
  postmortem            String?
  postmortemPublishedAt DateTime?

  // Escalation (see Monitor.escalationPolicyId / EscalateOverdueIncidents in
  // worker/internal/incidents). acknowledgedAt is the halting condition — once
  // set, no further escalation steps fire. escalationStep counts how many
  // steps have already been paged; lastEscalatedAt is the clock the next
  // step's delayMinutes counts from (falls back to createdAt for step 0).
  acknowledgedAt   DateTime?
  acknowledgedById String?
  acknowledgedBy   User?     @relation("IncidentAcknowledgedBy", fields: [acknowledgedById], references: [id], onDelete: SetNull)
  escalationStep   Int       @default(0)
  lastEscalatedAt  DateTime?

  updates               IncidentUpdate[]
  subscribers           IncidentSubscriber[]
  integrationDeliveries IntegrationDelivery[]

  @@index([monitorId])
  @@index([createdById])
  @@index([acknowledgedById])
  @@map("incident")
}

// A timeline entry on an incident (e.g. "We've identified the issue"). Every
// status change (including the initial report and the final resolution) is
// recorded as one of these, so the incident's history is just its update list.
model IncidentUpdate {
  id         String   @id @default(cuid())
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  status     String // Investigating | Identified | Monitoring | Resolved
  message    String
  authorId   String? // null when posted automatically by a worker
  author     User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([incidentId, createdAt])
  @@map("incident_update")
}

// Email subscribers for incident notifications. Self-serve "Subscribe to
// updates" is a future feature — rows here can currently only exist if seeded
// directly — but every incident update already emails whoever is in here.
model IncidentSubscriber {
  id         String   @id @default(cuid())
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  email      String
  createdAt  DateTime @default(now())

  @@unique([incidentId, email])
  @@map("incident_subscriber")
}

// A public status page: a curated view of some of your monitors, with an
// uptime history, incident feed, and its own subscribers — served at
// /status/[slug] (see src/app/(status)).
model StatusPage {
  id                String   @id @default(cuid())
  name              String
  slug              String   @unique
  // Optional vanity hostname (no protocol, no port — e.g. "status.acme.com")
  // that transparently shows this page instead of /status/[slug]. Resolved
  // in src/proxy.ts via src/app/api/public/status-domain. Pointing the DNS
  // record (CNAME/A) at wherever this app is hosted, and any TLS for it, is
  // on the operator — this app only does the request-time rewrite.
  customDomain      String?  @unique
  description       String?
  logoUrl           String?
  theme             String   @default("system") // light | dark | system
  primaryColor      String   @default("#7c3aed")
  historyWindowDays Int      @default(90) // 7 | 30 | 90
  isPublished       Boolean  @default(true)
  // Whether each monitor's tags are shown next to its name on this page.
  showTags          Boolean  @default(false)
  createdById       String?
  createdBy         User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  groups      StatusPageGroup[]
  monitors    StatusPageMonitor[]
  subscribers StatusPageSubscriber[]

  @@index([createdById])
  @@map("status_page")
}

// A user-defined heading monitors can be grouped under on a status page (e.g.
// "Core services" / "Third-party dependencies"). Purely cosmetic grouping —
// scoped to one status page.
model StatusPageGroup {
  id           String     @id @default(cuid())
  statusPageId String
  statusPage   StatusPage @relation(fields: [statusPageId], references: [id], onDelete: Cascade)
  name         String
  order        Int        @default(0)

  monitors StatusPageMonitor[]

  @@index([statusPageId])
  @@map("status_page_group")
}

// Join row: which monitors appear on a status page, in which group (if any),
// and in what order.
model StatusPageMonitor {
  id           String           @id @default(cuid())
  statusPageId String
  statusPage   StatusPage       @relation(fields: [statusPageId], references: [id], onDelete: Cascade)
  monitorId    String
  monitor      Monitor          @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  groupId      String?
  group        StatusPageGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  order        Int              @default(0)

  @@unique([statusPageId, monitorId])
  @@index([statusPageId])
  @@index([groupId])
  @@map("status_page_monitor")
}

// Someone subscribed to updates for an entire status page (as opposed to
// IncidentSubscriber, which is scoped to one incident) — notified by email or
// a Discord webhook whenever an incident affecting one of this page's
// monitors gets a new update.
model StatusPageSubscriber {
  id           String     @id @default(cuid())
  statusPageId String
  statusPage   StatusPage @relation(fields: [statusPageId], references: [id], onDelete: Cascade)
  channel      String // Email | Discord
  target       String // email address, or a Discord webhook URL
  createdAt    DateTime   @default(now())

  @@unique([statusPageId, channel, target])
  @@index([statusPageId])
  @@map("status_page_subscriber")
}

// A scheduled or in-progress maintenance window covering one or more
// monitors. While `now` falls within [startsAt, endsAt] (and it hasn't been
// cancelled), the monitor-check workers (worker/internal/runner, the Go port
// of what used to be src/lib/monitor-worker.ts) still
// check and record pings as usual, but suppress opening/alerting a new
// incident for a Down/Degraded result — see src/lib/maintenance.ts. Shown on
// the public status page as a "Scheduled maintenance" notice instead of an
// outage.
model MaintenanceWindow {
  id          String    @id @default(cuid())
  title       String
  message     String? // shown on the public status page
  startsAt    DateTime
  endsAt      DateTime
  cancelledAt DateTime?
  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  monitors MaintenanceWindowMonitor[]

  @@index([createdById])
  @@index([startsAt, endsAt])
  @@map("maintenance_window")
}

// Join row: which monitors a maintenance window covers.
model MaintenanceWindowMonitor {
  id                  String            @id @default(cuid())
  maintenanceWindowId String
  maintenanceWindow   MaintenanceWindow @relation(fields: [maintenanceWindowId], references: [id], onDelete: Cascade)
  monitorId           String
  monitor             Monitor           @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@unique([maintenanceWindowId, monitorId])
  @@index([maintenanceWindowId])
  @@index([monitorId])
  @@map("maintenance_window_monitor")
}

// A record of a significant dashboard action, shown on the Logs page's Audit
// Logs tab. actorName is a denormalized snapshot so the log stays readable
// even after the acting user is deleted (actorId goes null via SetNull).
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorName String
  action    String // e.g. CREATED_MONITOR, RESOLVED_INCIDENT, DELETED_STATUS_PAGE
  target    String // human-readable label of what was acted on
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("audit_log")
}

// An outgoing notification channel (Discord/Slack/Webhook/Telegram/Email/
// PagerDuty). `target` holds the primary destination (webhook URL, email
// address, chat ID, or PagerDuty routing key); `secret` only applies to
// Telegram (bot token).
model Integration {
  id          String   @id @default(cuid())
  name        String
  type        String // Discord | Slack | Webhook | Telegram | Email | PagerDuty
  target      String
  secret      String?
  enabled     Boolean  @default(true)
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deliveries      IntegrationDelivery[]
  escalationSteps EscalationStep[]

  @@index([createdById])
  @@map("integration")
}

// A queued/attempted notification through one Integration. Written by
// src/lib/incidents.ts whenever an incident update happens (or by a manual
// "Send test" action) and delivered by the Go worker/cmd/integrations binary.
model IntegrationDelivery {
  id            String      @id @default(cuid())
  integrationId String
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  incidentId    String?
  incident      Incident?   @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  event         String // e.g. "Incident Alert", "Test Notification"
  message       String
  status        String      @default("Pending") // Pending | Sent | Failed
  attempts      Int         @default(0)
  error         String?
  createdAt     DateTime    @default(now())
  sentAt        DateTime?

  @@index([integrationId, createdAt])
  @@index([status])
  @@map("integration_delivery")
}

// A named, ordered paging chain — attach to a Monitor (Monitor.escalationPolicyId)
// to replace the default "broadcast to every enabled Integration" behavior for
// that monitor's incidents with "page step 1, and if nobody acknowledges within
// step N's delayMinutes, page step N+1", stopping once the incident is
// acknowledged or resolved. See worker/internal/incidents's EscalateOverdueIncidents (the Go integrations worker).
model EscalationPolicy {
  id          String   @id @default(cuid())
  name        String
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  steps    EscalationStep[]
  monitors Monitor[]

  @@index([createdById])
  @@map("escalation_policy")
}

// One rung of an EscalationPolicy's ladder: after `delayMinutes` of no
// acknowledgement (counted from the incident opening, or from the previous
// step firing), page `integration`. `order` is 0-indexed and matches
// Incident.escalationStep.
model EscalationStep {
  id                 String           @id @default(cuid())
  escalationPolicyId String
  escalationPolicy   EscalationPolicy @relation(fields: [escalationPolicyId], references: [id], onDelete: Cascade)
  order              Int              @default(0)
  delayMinutes       Int
  integrationId      String
  integration        Integration      @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([escalationPolicyId, order])
  @@index([escalationPolicyId])
  @@index([integrationId])
  @@map("escalation_step")
}

// A label attachable to monitors (e.g. "production", "third-party") via
// MonitorTag. Created implicitly — find-or-create by name — whenever a
// monitor is saved with a tag name that doesn't exist yet (see
// src/trpc/routers/monitor.ts).
model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String   @default("#7c3aed")
  createdAt DateTime @default(now())

  monitors MonitorTag[]

  @@map("tag")
}

// Join row: which tags are on which monitor.
model MonitorTag {
  id        String  @id @default(cuid())
  monitorId String
  monitor   Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  tagId     String
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([monitorId, tagId])
  @@index([monitorId])
  @@index([tagId])
  @@map("monitor_tag")
}

// Single-row table (id is always "singleton") holding instance-wide config
// shown on the Settings page. Use src/lib/settings.ts's getSettings() rather
// than querying this directly — it creates the row (with generated API/
// webhook secrets) on first use.
model AppSettings {
  id                       String   @id @default("singleton")
  organizationName         String   @default("My Organization")
  timezone                 String   @default("utc")
  supportEmail             String?
  defaultCheckInterval     String   @default("60s") // 15s | 30s | 60s | 5m
  httpTimeoutSeconds       Int      @default(30)
  failedAttemptsThreshold  Int      @default(1)
  latencyThresholdMs       Int      @default(2000)
  sslCheckEnabled          Boolean  @default(true)
  certExpiryWarningEnabled Boolean  @default(true)
  smtpHost                 String?
  smtpPort                 Int?
  smtpUser                 String?
  smtpPass                 String?
  smtpFromEmail            String?
  smtpFromName             String?
  smtpUseTls               Boolean  @default(true)
  apiKey                   String   @unique
  webhookSigningSecret     String
  // VAPID key pair for the "Push" integration channel (browser/mobile web
  // push, src/lib/push.ts). Generated once on first use (see
  // src/lib/settings.ts) and reused for every subscription — the public key
  // is exposed to the browser to create a PushSubscription, the private key
  // signs outgoing pushes and never leaves the server.
  vapidPublicKey           String?
  vapidPrivateKey          String?
  updatedAt                DateTime @updatedAt

  @@map("app_settings")
}
