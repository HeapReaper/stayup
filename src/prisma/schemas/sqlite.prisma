datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String           @id
  name            String
  email           String
  emailVerified   Boolean          @default(false)
  image           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  // better-auth's admin plugin (src/lib/auth.ts) — lets dashboard-authenticated
  // users create other users via auth.api.createUser without a public
  // self-service /register flow. Not used for permission gating anywhere in
  // this app (every logged-in user has full dashboard access, same as
  // before); the plugin just requires these columns to exist.
  role            String?
  banned          Boolean?         @default(false)
  banReason       String?
  banExpires      DateTime?
  sessions           Session[]
  accounts           Account[]
  monitors           Monitor[]
  incidents          Incident[]           @relation("IncidentCreatedBy")
  acknowledgedIncidents Incident[]        @relation("IncidentAcknowledgedBy")
  incidentUpdates    IncidentUpdate[]
  statusPages        StatusPage[]
  integrations       Integration[]
  auditLogs          AuditLog[]
  maintenanceWindows MaintenanceWindow[]
  escalationPolicies EscalationPolicy[]
  onCallSchedules    OnCallSchedule[]
  onCallShifts       OnCallParticipant[]
  notificationRules  NotificationRule[]

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  impersonatedBy String? // better-auth admin plugin column; unused (see User.role)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  type String?
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Monitor {
  id            String              @id @default(cuid())
  name          String
  url           String
  type          String              @default("HTTP") // HTTP | Ping | Port | DNS
  status        String              @default("Up") // Up | Down | Degraded
  interval      String              @default("60s") // 15s | 30s | 60s | 5m
  port          Int?
  // Paused monitors keep their history and stay on status pages, but no
  // worker checks them: the check workers filter on this column
  // (ListByType in worker/internal/store), so pausing takes effect within one
  // tick — no restart, no incident, no deletion of past checks.
  enabled       Boolean             @default(true)
  uptime        Float               @default(100)
  responseTime  Int?
  lastCheckedAt DateTime?
  // --- HTTP monitor options (ignored by the Ping/Port/DNS workers) ---
  // How the request is made. `requestHeaders` is a JSON object
  // ({"Authorization": "Bearer ..."}) kept as text because it's only ever
  // read back verbatim; the monitor router validates it's parseable on write.
  method          String   @default("GET") // GET | HEAD | POST | PUT | PATCH | DELETE
  requestHeaders  String?
  requestBody     String?
  followRedirects Boolean  @default(true)
  // Which response codes count as up: comma-separated codes and/or inclusive
  // ranges ("200", "200,201", "200-204,301"). Null/empty keeps the original
  // behavior — any 2xx is up, everything else is down.
  expectedStatusCodes String?
  // Content assertion. `keyword` is the operand and `assertionType` decides
  // how it's applied to the response body; `keywordInverted` negates whichever
  // one is selected. Only the first megabyte of the body is searched (see
  // worker/internal/checkers/http.go).
  //   Contains — `keyword` must appear in the body verbatim (the original,
  //              and still the default for every existing row)
  //   Regex    — `keyword` is an RE2 pattern that must match somewhere
  //   JsonPath — `jsonPath` selects a value out of the JSON body, which must
  //              equal `keyword`; a blank keyword asserts the path merely
  //              resolves to something
  keyword         String?
  keywordInverted Boolean  @default(false)
  assertionType   String   @default("Contains") // Contains | Regex | JsonPath
  jsonPath        String?
  // Secret half of a non-HTTP check's credentials: the Redis/database
  // password, or the SMTP/IMAP password. The username and everything else
  // lives in `url` (a DSN for Postgres/MySQL, a bare host otherwise), so this
  // is the only field that has to be kept out of logs.
  credential      String?
  // NotAfter equivalent for a Domain monitor: the registry expiry date the
  // last RDAP lookup saw (worker/internal/checkers/domain.go). Same role
  // certExpiresAt plays for HTTPS — a vergeten domeinverlenging takes a site
  // down just as hard as an expired certificate.
  domainExpiresAt DateTime?
  // When this monitor was first seen flapping, or null when it isn't. Set and
  // cleared by the check workers (worker/internal/flapping); while it's set,
  // incident open/close is suppressed the same way a maintenance window
  // suppresses it, so a monitor bouncing 20x an hour pages once instead of 20
  // times.
  flappingSince   DateTime?
  // Availability target this monitor is measured against on the Reports page,
  // as a percentage (99.9). Null means it isn't held to one.
  sloTarget       Float?
  // Per-monitor overrides of the instance-wide monitoring defaults in
  // AppSettings. Null means "use the instance value", which is what every
  // existing monitor keeps. A slow nightly batch API and a health endpoint
  // are never usefully held to the same latency threshold, and a flaky
  // third-party dependency needs a different confirmation count from a
  // service you own — so these three are the ones worth overriding.
  // Resolved in worker/internal/settings's ForMonitor().
  httpTimeoutSeconds      Int?
  failedAttemptsThreshold Int?
  latencyThresholdMs      Int?
  // NotAfter of the TLS certificate seen on the most recent check, or null if
  // that check wasn't HTTPS. Written by the https worker; read by the
  // "Certificate Expiry Warning" logic and shown in the monitors list.
  certExpiresAt   DateTime?
  createdById   String?
  createdBy     User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  // Optional paging chain — if set, an open incident on this monitor is paged
  // through EscalationPolicy.steps (in order, one step per X minutes of no
  // acknowledgement) instead of the usual broadcast to every enabled
  // Integration. See worker/internal/incidents's EscalateOverdueIncidents (the Go integrations worker).
  escalationPolicyId String?
  escalationPolicy   EscalationPolicy? @relation(fields: [escalationPolicyId], references: [id], onDelete: SetNull)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  checks              MonitorCheck[]
  dailyStats          MonitorDailyStat[]
  incidents           Incident[]
  statusPages         StatusPageComponent[]
  maintenanceWindows  MaintenanceWindowMonitor[]
  tags                MonitorTag[]
  notificationRules   NotificationRule[]

  @@index([createdById])
  @@index([escalationPolicyId])
  @@map("monitor")
}

// A single check performed by a worker (e.g. the Go binary built from worker/cmd/https) against a
// monitor. Each row is one "ping" — the aggregate fields on Monitor (status,
// responseTime, uptime, lastCheckedAt) are derived from these.
model MonitorCheck {
  id           String   @id @default(cuid())
  monitorId    String
  monitor      Monitor  @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  status       String // Up | Down | Degraded
  statusCode   Int?
  responseTime Int? // ms
  message      String?
  checkedAt    DateTime @default(now())

  @@index([monitorId, checkedAt])
  @@map("monitor_check")
}

// One row per monitor per UTC day: that day's MonitorCheck rows, aggregated
// by worker/cmd/janitor once the day is over. It exists so that pruning raw
// checks doesn't erase status-page history — a 90-day status page keeps
// working on a 7-day raw retention. The public status page prefers these
// rows and only falls back to raw checks for days that have no rollup yet
// (i.e. today, which is still in progress).
model MonitorDailyStat {
  id              String   @id @default(cuid())
  monitorId       String
  monitor         Monitor  @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  day             DateTime // UTC midnight of the day being summarized
  totalChecks     Int
  upChecks        Int
  degradedChecks  Int
  downChecks      Int
  avgResponseTime Int?
  // Response-time distribution for the day, in ms. An average hides the tail
  // that users actually feel, so the Reports page reads these instead;
  // computed by cmd/janitor from the same raw checks the counters come from
  // (nearest-rank percentiles). Null on rows rolled up before these columns
  // existed, and on days where no check recorded a response time.
  p50ResponseTime Int?
  p95ResponseTime Int?
  p99ResponseTime Int?
  maxResponseTime Int?
  uptime          Float
  createdAt       DateTime @default(now())

  @@unique([monitorId, day])
  @@index([day])
  @@map("monitor_daily_stat")
}

model Incident {
  id          String    @id @default(cuid())
  title       String
  impact      String    @default("Major") // Critical | Major | Minor
  status      String    @default("Investigating") // Investigating | Identified | Monitoring | Resolved
  monitorId   String?
  monitor     Monitor?  @relation(fields: [monitorId], references: [id], onDelete: SetNull)
  createdById String? // null when auto-created by a worker
  createdBy   User?     @relation("IncidentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Root-cause writeup, added after the incident is resolved. Only shown on
  // the public status page once postmortemPublishedAt is set — saving a
  // draft (publishedAt still null) keeps it dashboard-only.
  postmortem            String?
  postmortemPublishedAt DateTime?

  // Escalation (see Monitor.escalationPolicyId / EscalateOverdueIncidents in
  // worker/internal/incidents). acknowledgedAt is the halting condition — once
  // set, no further escalation steps fire. escalationStep counts how many
  // steps have already been paged; lastEscalatedAt is the clock the next
  // step's delayMinutes counts from (falls back to createdAt for step 0).
  acknowledgedAt   DateTime?
  acknowledgedById String?
  acknowledgedBy   User?     @relation("IncidentAcknowledgedBy", fields: [acknowledgedById], references: [id], onDelete: SetNull)
  escalationStep   Int       @default(0)
  lastEscalatedAt  DateTime?

  updates               IncidentUpdate[]
  subscribers           IncidentSubscriber[]
  integrationDeliveries IntegrationDelivery[]

  @@index([monitorId])
  @@index([createdById])
  @@index([acknowledgedById])
  @@map("incident")
}

// A timeline entry on an incident (e.g. "We've identified the issue"). Every
// status change (including the initial report and the final resolution) is
// recorded as one of these, so the incident's history is just its update list.
model IncidentUpdate {
  id         String   @id @default(cuid())
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  status     String // Investigating | Identified | Monitoring | Resolved
  message    String
  authorId   String? // null when posted automatically by a worker
  author     User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([incidentId, createdAt])
  @@map("incident_update")
}

// Email subscribers for incident notifications, added by the "Notify me"
// button on the public status page (incident.subscribe). Every incident
// update emails everyone in here. There's no unsubscribe flow yet.
model IncidentSubscriber {
  id         String   @id @default(cuid())
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  email      String
  createdAt  DateTime @default(now())

  @@unique([incidentId, email])
  @@map("incident_subscriber")
}

// A public status page: a curated view of some of your monitors, with an
// uptime history, incident feed, and its own subscribers — served at
// /status/[slug] (see src/app/(status)).
model StatusPage {
  id                String   @id @default(cuid())
  name              String
  slug              String   @unique
  // Optional vanity hostname (no protocol, no port — e.g. "status.acme.com")
  // that transparently shows this page instead of /status/[slug]. Resolved
  // in src/proxy.ts via src/app/api/public/status-domain. Pointing the DNS
  // record (CNAME/A) at wherever this app is hosted, and any TLS for it, is
  // on the operator — this app only does the request-time rewrite.
  customDomain      String?  @unique
  description       String?
  logoUrl           String?
  theme             String   @default("system") // light | dark | system
  primaryColor      String   @default("#7c3aed")
  historyWindowDays Int      @default(90) // 7 | 30 | 90
  isPublished       Boolean  @default(true)
  // Whether each monitor's tags are shown next to its name on this page.
  showTags          Boolean  @default(false)
  // If true, only visitors signed in with a dashboard account can view this
  // page — unauthenticated visitors are redirected to /login. Enforced in
  // statusPage.getPublicBySlug (src/trpc/routers/statuspage.ts).
  requireLogin      Boolean  @default(false)
  createdById       String?
  createdBy         User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  groups      StatusPageGroup[]
  components  StatusPageComponent[]
  subscribers StatusPageSubscriber[]

  @@index([createdById])
  @@map("status_page")
}

// A user-defined heading monitors can be grouped under on a status page (e.g.
// "Core services" / "Third-party dependencies"). Purely cosmetic grouping —
// scoped to one status page.
model StatusPageGroup {
  id           String     @id @default(cuid())
  statusPageId String
  statusPage   StatusPage @relation(fields: [statusPageId], references: [id], onDelete: Cascade)
  name         String
  order        Int        @default(0)

  components StatusPageComponent[]

  @@index([statusPageId])
  @@map("status_page_group")
}

// One line on a status page, in a group (if any) and in an order.
//
// A component is usually backed by a Monitor, and then it reports whatever
// that monitor's checks say. It does not have to be: `monitorId` is nullable,
// so "Payments" can be a component whose state a human sets by hand — plenty
// of things worth telling customers about (a payment provider, a shipping
// partner, a partial feature degradation) have no endpoint this app could
// usefully poll.
//
// `manualStatus` wins whenever it is set, monitor-backed or not, which also
// makes it the override for "the checks say green but we know it isn't".
model StatusPageComponent {
  id           String           @id @default(cuid())
  statusPageId String
  statusPage   StatusPage       @relation(fields: [statusPageId], references: [id], onDelete: Cascade)
  // Null for a manual component. The unique constraint below still prevents
  // the same monitor appearing twice on one page — NULLs don't collide in a
  // unique index on either provider, so any number of manual components is
  // fine.
  monitorId    String?
  monitor      Monitor?         @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  groupId      String?
  group        StatusPageGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  order        Int              @default(0)
  // Label. Required in practice for a manual component; for a monitor-backed
  // one, null means "show the monitor's own name", so renaming the monitor
  // keeps the page in step.
  name         String?
  description  String?
  // Operational | Degraded | Outage | Maintenance. Null = derive it from the
  // monitor (and impossible to leave null on a manual component, which the
  // statusPage router enforces).
  manualStatus String?

  @@unique([statusPageId, monitorId])
  @@index([statusPageId])
  @@index([groupId])
  @@map("status_page_component")
}

// Someone subscribed to updates for an entire status page (as opposed to
// IncidentSubscriber, which is scoped to one incident) — notified by email or
// a Discord webhook whenever an incident affecting one of this page's
// monitors gets a new update.
model StatusPageSubscriber {
  id           String     @id @default(cuid())
  statusPageId String
  statusPage   StatusPage @relation(fields: [statusPageId], references: [id], onDelete: Cascade)
  channel      String // Email | Discord
  target       String // email address, or a Discord webhook URL
  createdAt    DateTime   @default(now())

  @@unique([statusPageId, channel, target])
  @@index([statusPageId])
  @@map("status_page_subscriber")
}

// A scheduled or in-progress maintenance window covering one or more
// monitors. While `now` falls within [startsAt, endsAt] (and it hasn't been
// cancelled), the monitor-check workers (worker/internal/runner, the Go port
// of what used to be src/lib/monitor-worker.ts) still
// check and record pings as usual, but suppress opening/alerting a new
// incident for a Down/Degraded result — see src/lib/maintenance.ts. Shown on
// the public status page as a "Scheduled maintenance" notice instead of an
// outage.
model MaintenanceWindow {
  id          String    @id @default(cuid())
  title       String
  message     String? // shown on the public status page
  startsAt    DateTime
  endsAt      DateTime
  cancelledAt DateTime?
  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  monitors MaintenanceWindowMonitor[]

  @@index([createdById])
  @@index([startsAt, endsAt])
  @@map("maintenance_window")
}

// Join row: which monitors a maintenance window covers.
model MaintenanceWindowMonitor {
  id                  String            @id @default(cuid())
  maintenanceWindowId String
  maintenanceWindow   MaintenanceWindow @relation(fields: [maintenanceWindowId], references: [id], onDelete: Cascade)
  monitorId           String
  monitor             Monitor           @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@unique([maintenanceWindowId, monitorId])
  @@index([maintenanceWindowId])
  @@index([monitorId])
  @@map("maintenance_window_monitor")
}

// A record of a significant dashboard action, shown on the Logs page's Audit
// Logs tab. actorName is a denormalized snapshot so the log stays readable
// even after the acting user is deleted (actorId goes null via SetNull).
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorName String
  action    String // e.g. CREATED_MONITOR, RESOLVED_INCIDENT, DELETED_STATUS_PAGE
  target    String // human-readable label of what was acted on
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("audit_log")
}

// An outgoing notification channel (Discord/Slack/Webhook/Telegram/Email/
// PagerDuty). `target` holds the primary destination (webhook URL, email
// address, chat ID, or PagerDuty routing key); `secret` only applies to
// Telegram (bot token).
model Integration {
  id          String   @id @default(cuid())
  name        String
  type        String // Discord | Slack | Webhook | Telegram | Email | PagerDuty
  target      String
  secret      String?
  enabled     Boolean  @default(true)
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deliveries         IntegrationDelivery[]
  escalationSteps    EscalationStep[]
  onCallParticipants OnCallParticipant[]
  notificationRules  NotificationRuleIntegration[]

  @@index([createdById])
  @@map("integration")
}

// A queued/attempted notification through one Integration. Written by
// src/lib/incidents.ts whenever an incident update happens (or by a manual
// "Send test" action) and delivered by the Go worker/cmd/integrations binary.
model IntegrationDelivery {
  id            String      @id @default(cuid())
  integrationId String
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  incidentId    String?
  incident      Incident?   @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  event         String // e.g. "Incident Alert", "Test Notification"
  message       String
  status        String      @default("Pending") // Pending | Sent | Failed
  attempts      Int         @default(0)
  error         String?
  createdAt     DateTime    @default(now())
  sentAt        DateTime?

  @@index([integrationId, createdAt])
  @@index([status])
  @@map("integration_delivery")
}

// A named, ordered paging chain — attach to a Monitor (Monitor.escalationPolicyId)
// to replace the default "broadcast to every enabled Integration" behavior for
// that monitor's incidents with "page step 1, and if nobody acknowledges within
// step N's delayMinutes, page step N+1", stopping once the incident is
// acknowledged or resolved. See worker/internal/incidents's EscalateOverdueIncidents (the Go integrations worker).
model EscalationPolicy {
  id          String   @id @default(cuid())
  name        String
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  steps    EscalationStep[]
  monitors Monitor[]

  @@index([createdById])
  @@map("escalation_policy")
}

// One rung of an EscalationPolicy's ladder: after `delayMinutes` of no
// acknowledgement (counted from the incident opening, or from the previous
// step firing), page this step's target. `order` is 0-indexed and matches
// Incident.escalationStep.
//
// A step targets exactly one of two things, enforced by the escalationPolicy
// router rather than by the schema (neither provider can express an XOR):
//   integrationId    — a fixed channel, the original behaviour
//   onCallScheduleId — whoever the rotation says is on call *at the moment
//                      the step fires*, resolved through that person's
//                      Integration (see src/lib/oncall.ts / internal/oncall)
model EscalationStep {
  id                 String           @id @default(cuid())
  escalationPolicyId String
  escalationPolicy   EscalationPolicy @relation(fields: [escalationPolicyId], references: [id], onDelete: Cascade)
  order              Int              @default(0)
  delayMinutes       Int
  integrationId      String?
  integration        Integration?     @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  onCallScheduleId   String?
  onCallSchedule     OnCallSchedule?  @relation(fields: [onCallScheduleId], references: [id], onDelete: Cascade)

  @@unique([escalationPolicyId, order])
  @@index([escalationPolicyId])
  @@index([integrationId])
  @@index([onCallScheduleId])
  @@map("escalation_step")
}

// A rotation: an ordered list of people, each reachable through one
// Integration, taking the pager in turn. Resolved at paging time — nothing
// precomputes a calendar, so changing the roster takes effect immediately.
model OnCallSchedule {
  id       String @id @default(cuid())
  name     String
  // IANA zone the handoff happens in ("Europe/Amsterdam"). Separate from
  // AppSettings.timezone so a follow-the-sun rotation can hand off at 09:00
  // local while the rest of the dashboard stays on the instance's zone.
  timezone String @default("UTC")
  // How long one person holds the pager, and when the handoff lands.
  rotationType String @default("Weekly") // Daily | Weekly
  handoffHour  Int    @default(9)        // 0-23, in `timezone`
  handoffDay   Int    @default(1)        // ISO weekday 1-7, Weekly rotations only
  // Anchor the rotation counts from. Every handoff is a whole number of
  // periods after this instant, so it decides *who* is first, not just when.
  startsAt     DateTime @default(now())

  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  participants OnCallParticipant[]
  overrides    OnCallOverride[]
  steps        EscalationStep[]

  @@index([createdById])
  @@map("on_call_schedule")
}

// One person in a rotation. `integrationId` is how they're actually paged —
// their personal Telegram chat, their phone's Web Push subscription, an
// email. `userId` is optional and only used to show a familiar name in the
// dashboard; someone can be on call without having a login.
model OnCallParticipant {
  id         String         @id @default(cuid())
  scheduleId String
  schedule   OnCallSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  order      Int            @default(0)
  name       String
  userId     String?
  user       User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  integrationId String
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  overrides OnCallOverride[]

  @@unique([scheduleId, order])
  @@index([scheduleId])
  @@index([userId])
  @@index([integrationId])
  @@map("on_call_participant")
}

// "I'm ill this week" — a fixed window where the rotation's answer is
// replaced. A null participant means nobody covers: paging falls through to
// the next escalation step instead of waking the person who is nominally up.
model OnCallOverride {
  id         String         @id @default(cuid())
  scheduleId String
  schedule   OnCallSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  startsAt   DateTime
  endsAt     DateTime
  participantId String?
  participant   OnCallParticipant? @relation(fields: [participantId], references: [id], onDelete: Cascade)
  reason     String?
  createdAt  DateTime @default(now())

  @@index([scheduleId, startsAt, endsAt])
  @@index([participantId])
  @@map("on_call_override")
}

// Routing for monitors that *don't* have an escalation policy. Without any
// rules the default is unchanged — every incident broadcasts to every enabled
// Integration. With rules, the first enabled one (by `order`) whose match
// clauses all hold decides what happens instead, so "staging alerts only
// during office hours, and only to #dev" is one row.
//
// Evaluated by notifyOrEscalate() in src/lib/incidents.ts and its Go mirror
// in worker/internal/incidents.
model NotificationRule {
  id      String  @id @default(cuid())
  name    String
  enabled Boolean @default(true)
  order   Int     @default(0)

  // Match clauses. Every one that is set must hold; all null matches
  // everything, which is how you write an instance-wide quiet-hours rule.
  matchTagId     String?
  matchTag       Tag?     @relation(fields: [matchTagId], references: [id], onDelete: Cascade)
  matchMonitorId String?
  matchMonitor   Monitor? @relation(fields: [matchMonitorId], references: [id], onDelete: Cascade)
  matchImpact    String? // Critical | Major | Minor

  // The window this rule's action applies in, in AppSettings.timezone.
  // activeDays is a comma-separated ISO weekday list ("1,2,3,4,5"); the two
  // minute-of-day bounds are inclusive-exclusive and may wrap past midnight
  // (22:00-06:00 is activeFromMinute 1320, activeUntilMinute 360). All three
  // null means "always".
  activeDays        String?
  activeFromMinute  Int?
  activeUntilMinute Int?

  // Route    — inside the window, deliver to `integrations` instead of
  //            broadcasting; outside it, deliver nothing.
  // Suppress — inside the window, deliver nothing at all (quiet hours).
  action String @default("Route") // Route | Suppress

  integrations NotificationRuleIntegration[]

  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([matchTagId])
  @@index([matchMonitorId])
  @@index([createdById])
  @@map("notification_rule")
}

// Join row: which Integrations a Route rule delivers to.
model NotificationRuleIntegration {
  id            String           @id @default(cuid())
  ruleId        String
  rule          NotificationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  integrationId String
  integration   Integration      @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([ruleId, integrationId])
  @@index([ruleId])
  @@index([integrationId])
  @@map("notification_rule_integration")
}

// A label attachable to monitors (e.g. "production", "third-party") via
// MonitorTag. Created implicitly — find-or-create by name — whenever a
// monitor is saved with a tag name that doesn't exist yet (see
// src/trpc/routers/monitor.ts).
model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String   @default("#7c3aed")
  createdAt DateTime @default(now())

  monitors          MonitorTag[]
  notificationRules NotificationRule[]

  @@map("tag")
}

// Join row: which tags are on which monitor.
model MonitorTag {
  id        String  @id @default(cuid())
  monitorId String
  monitor   Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  tagId     String
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([monitorId, tagId])
  @@index([monitorId])
  @@index([tagId])
  @@map("monitor_tag")
}

// Single-row table (id is always "singleton") holding instance-wide config
// shown on the Settings page. Use src/lib/settings.ts's getSettings() rather
// than querying this directly — it creates the row (with generated API/
// webhook secrets) on first use.
// One row per running worker binary, upserted on every tick. The one table
// the Next.js app only ever *reads*: it exists so the dashboard and
// /api/health can tell "no checks are arriving" apart from "this specific
// worker isn't running" — indistinguishable otherwise, since a monitor with
// no checks yet looks exactly like a monitor whose worker died.
model WorkerHeartbeat {
  // The binary's own name ("https" | "port" | "ping" | "dns" |
  // "integrations" | "janitor"), so there is exactly one row per worker and a
  // tick is an upsert rather than an ever-growing log.
  id              String   @id
  lastSeenAt      DateTime
  // This worker's tick cadence, so a reader can judge staleness without
  // hardcoding each binary's schedule — the check workers tick every 5
  // seconds, the janitor every 15 minutes.
  intervalSeconds Int
  // When this process started. Keeps moving on every restart, which is what
  // makes a crash-looping container visible instead of merely "alive".
  startedAt       DateTime
  // Build stamp of the image the worker is running (worker/internal/version).
  version         String?
  revision        String?

  @@map("worker_heartbeat")
}

model AppSettings {
  id                       String   @id @default("singleton")
  organizationName         String   @default("My Organization")
  timezone                 String   @default("utc")
  supportEmail             String?
  defaultCheckInterval     String   @default("60s") // 15s | 30s | 60s | 5m
  httpTimeoutSeconds       Int      @default(30)
  failedAttemptsThreshold  Int      @default(1)
  latencyThresholdMs       Int      @default(2000)
  // sslCheckEnabled off = don't verify TLS certificates at all (self-signed
  // and expired certs still count as up). On, a cert the Go TLS stack
  // rejects fails the check like any other connection error.
  sslCheckEnabled          Boolean  @default(true)
  // certExpiryWarningEnabled on = an HTTPS monitor whose certificate expires
  // within certExpiryWarningDays reports Degraded (and so opens an incident)
  // while it's still serving traffic fine.
  certExpiryWarningEnabled Boolean  @default(true)
  certExpiryWarningDays    Int      @default(14)
  // The same warning, one layer down the stack: a Domain monitor reports
  // Degraded once the registry expiry RDAP reports is inside this window.
  // Registrar renewal windows are measured in weeks, not days, hence the
  // wider default.
  domainExpiryWarningEnabled Boolean @default(true)
  domainExpiryWarningDays    Int     @default(30)
  // --- Flapping detection (worker/internal/flapping) ---
  // failedAttemptsThreshold debounces a single dip; this catches the opposite
  // failure, a monitor that alternates Up/Down all day. A monitor with at
  // least `flappingThreshold` status transitions inside
  // `flappingWindowMinutes` is marked flapping (monitor.flappingSince) and
  // stops opening and closing incidents until it settles — one "is flapping"
  // incident stands in for the storm.
  flappingEnabled          Boolean  @default(true)
  flappingWindowMinutes    Int      @default(60)
  flappingThreshold        Int      @default(6)
  // Retention, enforced once a day by worker/cmd/janitor: raw MonitorCheck
  // rows and finished (Sent/Failed) IntegrationDelivery rows older than this
  // are deleted. MonitorDailyStat rollups are never pruned, so status-page
  // history outlives the raw checks it was built from.
  checkRetentionDays       Int      @default(90)
  deliveryRetentionDays    Int      @default(30)
  smtpHost                 String?
  smtpPort                 Int?
  smtpUser                 String?
  smtpPass                 String?
  smtpFromEmail            String?
  smtpFromName             String?
  smtpUseTls               Boolean  @default(true)
  apiKey                   String   @unique
  webhookSigningSecret     String
  // VAPID key pair for the "Push" integration channel (browser/mobile web
  // push, src/lib/push.ts). Generated once on first use (see
  // src/lib/settings.ts) and reused for every subscription — the public key
  // is exposed to the browser to create a PushSubscription, the private key
  // signs outgoing pushes and never leaves the server.
  vapidPublicKey           String?
  vapidPrivateKey          String?
  // --- Update checks (src/lib/updates.ts / worker/internal/updates) ---
  // Off = nothing ever calls out on its own; the "Check now" button in
  // Dashboard -> Settings -> Updates still works. This is the only outbound
  // request StayUp makes that isn't a monitor check or a notification.
  updateCheckEnabled       Boolean   @default(true)
  // Newest version the last check saw: a release tag ("v1.4.0") on installs
  // pinned to a tag, or the newest default-branch commit's short SHA on
  // installs tracking `latest`. Whether it's *newer* than what's running is
  // decided on read against this process's own build version, so an upgrade
  // clears the banner without waiting for the next check.
  latestVersion            String?
  latestVersionUrl         String?
  latestVersionPublishedAt DateTime?
  lastUpdateCheckAt        DateTime?
  // Why the last check failed, or null if it succeeded — so the Updates tab
  // can say so instead of silently showing a stale latestVersion.
  lastUpdateCheckError     String?
  updatedAt                DateTime @updatedAt

  @@map("app_settings")
}
